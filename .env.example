# Configuración COMPARTIDA por todos los servicios del monorepo.
# Copia este archivo a ".env" (en la raíz) y genera una clave propia con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ".env" NUNCA se sube al repositorio (está en .gitignore).

# Clave para firmar y validar los tokens JWT (mínimo 32 caracteres).
# Debe ser la misma para api-usuarios (que firma) y api-autos (que valida).
JWT_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres

# Minutos de validez de cada token (opcional, por defecto 30).
# JWT_MINUTOS_EXPIRACION=30

# Puertos del host (opcionales). Útil si alguno está ocupado.
# AUTOS_PORT=8000
# USUARIOS_PORT=8001
