# Solo para desarrollo local (npm run dev). En Docker estas variables las
# define docker-compose.yml. Copia este archivo a ".env" si necesitas cambiarlas.
# ".env" NUNCA se sube al repositorio.

# URLs de las APIs. Solo las usa el servidor de Nuxt (BFF): el navegador nunca
# las conoce ni las llama directamente.
NUXT_API_AUTOS_URL=http://127.0.0.1:8000
NUXT_API_USUARIOS_URL=http://127.0.0.1:8001

# Cookie de sesión con el atributo Secure (solo se envía por HTTPS).
# Déjalo en false en http://localhost; ponlo en true en cualquier despliegue con HTTPS.
NUXT_COOKIE_SECURE=false
