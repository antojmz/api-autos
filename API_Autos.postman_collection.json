{
  "info": {
    "name": "API Concesionario de Autos",
    "description": "Colección para probar la API demo (FastAPI + PostgreSQL).\n\n1. Levanta la API: `uvicorn app.main:app --reload --host 127.0.0.1 --port 8000`\n2. Ejecuta las carpetas en orden (o la colección completa con el Collection Runner).\n\nLas variables `autoId` y `modeloId` se rellenan solas al crear recursos. Si usas otro host/puerto, cambia la variable `baseUrl`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "autoId",
      "value": ""
    },
    {
      "key": "modeloId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. General",
      "description": "Comprobar que la API responde.",
      "item": [
        {
          "name": "Bienvenida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Endpoint raíz con enlace a la documentación."
          }
        }
      ]
    },
    {
      "name": "2. Autos",
      "description": "CRUD de autos (flujo correcto).",
      "item": [
        {
          "name": "Crear auto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"autoId\", j.id);",
                  "pm.test(\"Devuelve id y marca\", function () { pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.marca).to.eql(\"Toyota\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos"
              ]
            },
            "description": "Crea un auto. Guarda su id en la variable `autoId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota\",\n  \"fecha_ingreso\": \"2026-01-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar autos (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Forma de página\", function () { pm.expect(pm.response.json()).to.have.keys(\"total\", \"skip\", \"limit\", \"items\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/autos?skip=0&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lista paginada: `skip` (desde) y `limit` (1 a 100)."
          }
        },
        {
          "name": "Filtrar autos por marca",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Encuentra el auto creado\", function () {",
                  "    const ids = pm.response.json().items.map(a => a.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"autoId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/autos?marca=toy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos"
              ],
              "query": [
                {
                  "key": "marca",
                  "value": "toy"
                }
              ]
            },
            "description": "Filtro por marca: contiene, sin distinguir mayúsculas."
          }
        },
        {
          "name": "Obtener auto por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/autos/{{autoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos",
                "{{autoId}}"
              ]
            },
            "description": "Obtiene un auto por su id."
          }
        },
        {
          "name": "Actualizar auto (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Marca actualizada\", function () { pm.expect(pm.response.json().marca).to.eql(\"Toyota Motor\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autos/{{autoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos",
                "{{autoId}}"
              ]
            },
            "description": "PUT es reemplazo completo: se envían todos los campos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota Motor\",\n  \"fecha_ingreso\": \"2026-01-05\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Modelos",
      "description": "Modelos asociados a un auto.",
      "item": [
        {
          "name": "Crear modelo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"modeloId\", j.id);",
                  "pm.test(\"Precio como string decimal exacto\", function () { pm.expect(j.precio).to.eql(\"25990.50\"); });"
                ]
