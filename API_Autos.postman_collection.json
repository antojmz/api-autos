              "raw": "{{baseUrl}}/modelo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelo"
              ]
            },
            "description": "Crea un modelo para el auto `autoId`. Guarda su id en `modeloId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auto_id\": {{autoId}},\n  \"nombre\": \"Corolla\",\n  \"anio\": 2024,\n  \"precio\": 25990.50,\n  \"fecha_ingreso\": \"2026-02-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear otro modelo (fecha por defecto = hoy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/modelo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelo"
              ]
            },
            "description": "Sin `fecha_ingreso`: la API usa la fecha de hoy.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auto_id\": {{autoId}},\n  \"nombre\": \"Yaris\",\n  \"anio\": 2025,\n  \"precio\": 18000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar autos con sus modelos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El auto tiene 2 modelos\", function () {",
                  "    const id = Number(pm.collectionVariables.get(\"autoId\"));",
                  "    const auto = pm.response.json().items.find(a => a.id === id);",
                  "    pm.expect(auto.modelos).to.have.lengthOf(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/modelos/autos?skip=0&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelos",
                "autos"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Autos con sus modelos anidados (paginado)."
          }
        }
      ]
    },
