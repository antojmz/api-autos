                  "    const id = Number(pm.collectionVariables.get(\"autoId\"));",
                  "    const auto = pm.response.json().items.find(a => a.id === id);",
                  "    pm.expect(auto.modelos).to.have.lengthOf(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
