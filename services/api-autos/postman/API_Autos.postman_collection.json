{
  "info": {
    "name": "API Concesionario de Autos",
    "description": "Colección para probar api-autos. Todas sus rutas (salvo `/`) requieren un token JWT emitido por api-usuarios.\n\n1. Levanta los servicios desde la raíz del monorepo: `docker compose up -d`\n2. Pon en la variable de colección `adminPassword` el valor de `ADMIN_PASSWORD` de `services/api-usuarios/.env`.\n3. Ejecuta la colección completa con el Collection Runner. La carpeta \"0. Autenticación\" obtiene los tokens.\n\nLas variables `token`, `userToken`, `autoId` y `modeloId` se rellenan solas. Si usas otros puertos, cambia `baseUrl` y `baseUrlUsuarios`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "baseUrlUsuarios",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "",
      "description": "ADMIN_PASSWORD de services/api-usuarios/.env"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "autoId",
      "value": ""
    },
    {
      "key": "modeloId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Autenticación",
      "description": "Obtiene los tokens en api-usuarios: admin (`token`) y un usuario normal (`userToken`).",
      "item": [
        {
          "name": "Login admin (api-usuarios)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", String(Date.now()).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrlUsuarios}}/auth/login",
              "host": [
                "{{baseUrlUsuarios}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token del admin en `token`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{adminUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Registrar usuario normal (api-usuarios)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrlUsuarios}}/auth/registro",
              "host": [
                "{{baseUrlUsuarios}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "Usuario sin rol admin, para probar el 403.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"autos.{{runId}}\",\n  \"email\": \"autos.{{runId}}@example.com\",\n  \"nombre_completo\": \"Usuario Autos\",\n  \"password\": \"Clave-Inicial-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login usuario normal (api-usuarios)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrlUsuarios}}/auth/login",
              "host": [
                "{{baseUrlUsuarios}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda su token en `userToken`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "autos.{{runId}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Clave-Inicial-2026",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. General",
      "description": "Comprobar que la API responde.",
      "item": [
        {
          "name": "Bienvenida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Endpoint raíz con enlace a la documentación.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Autos",
      "description": "CRUD de autos (flujo correcto).",
      "item": [
        {
          "name": "Crear auto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"autoId\", j.id);",
                  "pm.test(\"Devuelve id y marca\", function () { pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.marca).to.eql(\"Toyota\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos"
              ]
            },
            "description": "Crea un auto. Guarda su id en la variable `autoId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota\",\n  \"fecha_ingreso\": \"2026-01-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar autos (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Forma de página\", function () { pm.expect(pm.response.json()).to.have.keys(\"total\", \"skip\", \"limit\", \"items\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/autos?skip=0&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lista paginada: `skip` (desde) y `limit` (1 a 100)."
          }
        },
        {
          "name": "Filtrar autos por marca",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Encuentra el auto creado\", function () {",
                  "    const ids = pm.response.json().items.map(a => a.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"autoId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/autos?marca=toy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos"
              ],
              "query": [
                {
                  "key": "marca",
                  "value": "toy"
                }
              ]
            },
            "description": "Filtro por marca: contiene, sin distinguir mayúsculas."
          }
        },
        {
          "name": "Obtener auto por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/autos/{{autoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos",
                "{{autoId}}"
              ]
            },
            "description": "Obtiene un auto por su id."
          }
        },
        {
          "name": "Actualizar auto (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Marca actualizada\", function () { pm.expect(pm.response.json().marca).to.eql(\"Toyota Motor\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/autos/{{autoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "autos",
                "{{autoId}}"
              ]
            },
            "description": "PUT es reemplazo completo: se envían todos los campos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota Motor\",\n  \"fecha_ingreso\": \"2026-01-05\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
