# Copia este archivo a ".env" y completa los valores reales.
# ".env" NUNCA debe subirse al repositorio (está en .gitignore).
# La clave JWT NO va aquí: está en el .env de la RAÍZ del monorepo.

# Misma base de datos que api-autos (esquema public).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_DATABASE=autos
DB_PASS=cambia-esta-clave

# Administrador inicial: se crea al arrancar si no existe ningún admin.
# La contraseña debe tener 10-128 caracteres, al menos una letra y un número.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-clave-123

# Opcional: orígenes permitidos por CORS (formato JSON).
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
